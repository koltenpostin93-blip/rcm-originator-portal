# Leave unset to use a local SQLite file (rcm_portal.db).
#
# Postgres example:
# DATABASE_URL=postgresql://user:password@host:5432/rcm_portal
#
# Snowflake example (requires snowflake-sqlalchemy, already in requirements.txt):
# DATABASE_URL=snowflake://APP_USER:password@myorg-myaccount/RCM_PORTAL/PUBLIC?warehouse=RCM_PORTAL_WH&role=RCM_PORTAL_ROLE
DATABASE_URL=

# Massive.com Futures REST API key (https://massive.com/dashboard/api-keys) —
# used to look up live futures prices when overriding a Purchase's futures
# month to a contract RCM's own board doesn't quote.
MASSIVE_API_KEY=
